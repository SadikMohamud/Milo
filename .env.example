# --- Broker (Alpaca PAPER only) ---------------------------------------------
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_PAPER=True

# --- Agents ------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5

# --- Universe ----------------------------------------------------------------
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL

# --- Risk limits (fractions, not percentages) --------------------------------
MAX_POSITION_PERCENT=0.10
MIN_CASH_BUFFER_PERCENT=0.20
HARD_STOP_LOSS_PERCENT=0.10
DAILY_LOSS_LIMIT_PERCENT=0.03
MIN_CONVICTION=0.65

# --- Scheduling (US/Eastern, Mon-Fri) ----------------------------------------
SCHEDULED_HOUR_EST=8
SCHEDULED_MIN_EST=30
RECONCILE_HOUR_EST=10
RECONCILE_MIN_EST=0

# --- Execution / storage -----------------------------------------------------
FILL_WAIT_SECONDS=20
DB_PATH=forge_trader.db
