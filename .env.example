# --- Broker (Alpaca PAPER only) ---------------------------------------------
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_PAPER=True

# --- Agents ------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default model for every agent. Run `python forge_trader.py --models` for the list.
# claude-opus-5 | claude-opus-4-8 | claude-sonnet-5 | claude-haiku-4-5 | claude-fable-5
CLAUDE_MODEL=claude-opus-5

# Optional per-role routing. Leave blank to use CLAUDE_MODEL for both.
# A common split: cheaper analysts feeding an Opus portfolio manager.
ANALYST_MODEL=
PM_MODEL=

# Reasoning effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# Output ceilings per agent call (adaptive thinking is billed inside these).
ANALYST_MAX_TOKENS=8000
PM_MAX_TOKENS=8000

# --- Universe ----------------------------------------------------------------
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL

# --- Risk limits (fractions, not percentages) --------------------------------
MAX_POSITION_PERCENT=0.10
MIN_CASH_BUFFER_PERCENT=0.20
HARD_STOP_LOSS_PERCENT=0.10
DAILY_LOSS_LIMIT_PERCENT=0.03
MIN_CONVICTION=0.65

# --- Scheduling (US/Eastern, Mon-Fri) ----------------------------------------
SCHEDULED_HOUR_EST=8
SCHEDULED_MIN_EST=30
RECONCILE_HOUR_EST=10
RECONCILE_MIN_EST=0

# --- Execution / storage -----------------------------------------------------
FILL_WAIT_SECONDS=20
DB_PATH=forge_trader.db
